{
  "modelVersion": 1,
  "repositories": [
    "https://repo.maven.apache.org/maven2",
    "https://dl.google.com/dl/android/maven2"
  ],
  "modules": [
    {
      "name": "core",
      "type": "java-library"
    },
    {
      "name": "app",
      "type": "application",
      "dependencies": [
        { "project": "core", "scope": "api" }
      ],
      "android": {
        "manifest": "src/main/AndroidManifest.xml",
        "res": ["src/main/res"],
        "minSdk": 28,
        "targetSdk": 34,
        "namespace": "demo.app",
        "versionCode": 4,
        "versionName": "1.3-forge",
        "buildFeatures": {
          "buildConfig": true,
          "viewBinding": true
        },
        "buildConfigFields": [
          { "type": "String", "name": "EXEMPLE_URL",
            "value": "\"https://exemple.forge.dev\"" }
        ]
      }
    }
  ]
}
