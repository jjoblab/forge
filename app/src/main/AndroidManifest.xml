<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Téléchargement des composants du moteur et communication locale. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Le service hôte supervise le moteur pendant les builds (service premier plan). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Installation des APK construits par le moteur (confirmation système exigée :
         jamais d'installation silencieuse ; targetSdk 28 assumé, hors magasins). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Forge"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service hôte : supervision du moteur en premier plan (aucun export :
             seule la coquille le démarre). -->
        <service
            android:name=".ForgeHostService"
            android:exported="false" />
    </application>
</manifest>
