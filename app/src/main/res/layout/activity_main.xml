<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/engine_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_engine"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead"
            android:textColor="#263238"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/engine_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_engine_missing"
            android:textAppearance="@android:style/TextAppearance.Material.Title" />

        <TextView
            android:id="@+id/engine_status_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_engine_missing_hint"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <Button
            android:id="@+id/action_test_engine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_test_engine" />

        <!-- Assistant d'installation du moteur : canal, composants, progression. -->
        <LinearLayout
            android:id="@+id/install_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_install"
                android:textAppearance="@android:style/TextAppearance.Material.Subhead"
                android:textColor="#263238"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/install_channel_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/install_channel_hint"
                android:inputType="textUri"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/action_load_manifest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_load_manifest" />

            <TextView
                android:id="@+id/install_components"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textAppearance="@android:style/TextAppearance.Material.Caption"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/install_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/install_mobile_data_warning"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:textColor="#B26A00"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/action_install_engine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/action_install_engine" />

                <Button
                    android:id="@+id/action_cancel_install"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/action_cancel_install" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/install_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="1"
                android:progress="0" />

            <TextView
                android:id="@+id/install_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:textStyle="bold" />

            <Button
                android:id="@+id/action_uninstall_engine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_uninstall_engine" />
        </LinearLayout>

        <TextView
            android:id="@+id/build_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/section_build"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead"
            android:textColor="#263238"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/build_project_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/build_project_path_hint"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/action_import_examples"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_import_examples" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/action_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_build" />

            <Button
                android:id="@+id/action_cancel_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/action_cancel_build" />

            <Button
                android:id="@+id/action_install_apk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/action_install_apk" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/build_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="1"
            android:progress="0" />

        <TextView
            android:id="@+id/build_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/build_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:fontFamily="monospace"
            android:minHeight="160dp"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textAppearance="@android:style/TextAppearance.Material.Caption"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
