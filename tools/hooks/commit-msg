#!/usr/bin/env bash
# Hook commit-msg : refuse le commit si son message contient un terme interdit
# (insensible à la casse). La liste des termes est lue depuis .git/info/forbidden-terms.txt
# (fichier NON versionné).
set -uo pipefail

MSG_FILE="${1:?argument manquant : fichier du message de commit}"
TERMS_FILE="$(git rev-parse --git-dir)/info/forbidden-terms.txt"

if [ ! -f "$TERMS_FILE" ]; then
  echo "commit-msg : liste de termes interdits introuvable : $TERMS_FILE" >&2
  echo "  Lancez ./tools/setup-local.sh puis peuplez ce fichier avant de committer." >&2
  exit 1
fi

mapfile -t TERMS < <(grep -vE '^\s*(#|$)' "$TERMS_FILE" || true)
if [ "${#TERMS[@]}" -eq 0 ]; then
  echo "commit-msg : la liste de termes interdits est vide — peuplez $TERMS_FILE." >&2
  exit 1
fi

failed=0
for term in "${TERMS[@]}"; do
  if grep -Finq -- "$term" "$MSG_FILE"; then
    echo "commit-msg : terme interdit « ${term} » dans le message de commit :" >&2
    grep -Fin -- "$term" "$MSG_FILE" | head -3 | sed 's/^/    /' >&2
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "Commit refusé. Reformulez le message (citations autorisées uniquement dans docs/REFERENCES.md)." >&2
fi
exit "$failed"
